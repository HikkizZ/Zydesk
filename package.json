{
  "name": "zydesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "apps/bot"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "npm run build -w @zydesk/shared",
    "dev": "npm run build -w @zydesk/shared && concurrently -n shared,api,web,bot -c blue,green,magenta,yellow \"npm run dev -w @zydesk/shared\" \"npm run dev -w @zydesk/api\" \"npm run dev -w @zydesk/web\" \"npm run dev -w @zydesk/bot\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run build -w @zydesk/shared && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf packages/shared/dist apps/api/dist apps/web/dist apps/bot/dist",
    "db:migrar": "npm run db:migrar -w @zydesk/api",
    "db:revertir": "npm run db:revertir -w @zydesk/api",
    "db:admin": "npm run db:admin -w @zydesk/api --",
    "db:sembrar": "npm run db:sembrar -w @zydesk/api",
    "db:reiniciar": "npm run db:reiniciar -w @zydesk/api",
    "db:demo": "npm run db:demo -w @zydesk/api --",
    "db:test:crear": "npm run db:test:crear -w @zydesk/api --",
    "api:openapi": "npm run openapi -w @zydesk/api",
    "test:movil": "npm run test:movil -w @zydesk/web",
    "docs:capturas": "npm run docs:capturas -w @zydesk/web",
    "version:fijar": "node scripts/version-fijar.mjs",
    "test:scripts": "node --test scripts/version-fijar.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
