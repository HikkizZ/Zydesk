{
  "name": "@zydesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env TZ=UTC tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "cross-env TZ=UTC node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env TZ=UTC NODE_ENV=test vitest run",
    "db:migrar": "cross-env TZ=UTC tsx src/database/cli.ts migrar",
    "db:revertir": "cross-env TZ=UTC tsx src/database/cli.ts revertir",
    "db:admin": "cross-env TZ=UTC tsx src/database/cli.ts admin",
    "db:sembrar": "cross-env TZ=UTC tsx src/database/cli.ts sembrar",
    "db:reiniciar": "cross-env TZ=UTC tsx src/database/cli.ts reiniciar",
    "db:test:crear": "cross-env TZ=UTC tsx src/database/cli.ts bd-test crear",
    "openapi": "cross-env TZ=UTC tsx src/database/cli.ts openapi"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@scalar/express-api-reference": "^0.10.24",
    "@zydesk/shared": "*",
    "argon2": "^0.45.1",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "file-type": "^19.6.0",
    "helmet": "^8.3.0",
    "html-to-text": "^9.0.5",
    "mailparser": "^3.9.32",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}
