{
  "name": "@zydesk/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formato": {
      "types": "./dist/formato/index.d.ts",
      "default": "./dist/formato/index.js"
    },
    "./esquemas": {
      "types": "./dist/esquemas/index.d.ts",
      "default": "./dist/esquemas/index.js"
    },
    "./horas-habiles": {
      "types": "./dist/horas-habiles/index.d.ts",
      "default": "./dist/horas-habiles/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env TZ=UTC vitest run"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "zod": "^4.6.5"
  }
}
