# Entorno: development | test | production
NODE_ENV=development

# Postgres (usado por docker-compose.dev.yml)
POSTGRES_USER=zydesk
POSTGRES_PASSWORD=zydesk
POSTGRES_DB=zydesk
POSTGRES_PORT=5433

# API
API_PUERTO=3010
# Conexiones: la app usa zydesk_app; las migraciones, zydesk_owner
DATABASE_URL=postgres://zydesk_app:zydesk_app@localhost:5433/zydesk
DATABASE_URL_OWNER=postgres://zydesk_owner:zydesk_owner@localhost:5433/zydesk
TEST_DATABASE_URL=postgres://zydesk_app:zydesk_app@localhost:5433/zydesk_test
TEST_DATABASE_URL_OWNER=postgres://zydesk_owner:zydesk_owner@localhost:5433/zydesk_test
# Archivos en disco (ADR 0009); ruta relativa a la raíz del repo o absoluta. `datos/` está en .gitignore
ARCHIVOS_DIR=./datos/archivos
# Solo tests de la API: si falta, se usa un directorio temporal por proceso
TEST_ARCHIVOS_DIR=
# Solo para `npm run db:test:crear` (base de test por bloque, spec fase-2 §1.1)
TEST_BD_SUFIJO=
# error | warn | info | debug — por defecto: debug en development, info en el resto
LOG_LEVEL=

# Sesiones y proxy (ADR 0013)
PROXY_SALTOS=0
# Jobs pg-boss en este proceso (ADR 0008)
EJECUTAR_JOBS=true
# El job diario consulta Boostr y mindicador.cl para la UF; `false` apaga las llamadas salientes
# (CI, entornos sin internet); la UF se puede escribir a mano en cada cotización
UF_ACTUALIZAR=true

# Contraseña del primer usuario Administración (solo la lee `npm run db:admin`)
ADMIN_PASSWORD=
# Contraseña común de las semillas de desarrollo (solo la lee `npm run db:sembrar`)
SEMILLA_PASSWORD=

# Semilla de demo (`npm run db:demo`, spec fase 9 §11): datos 100 % ficticios. Sin ZYDESK_DEMO=true el comando se niega a
# correr. DEMO_PASSWORD es la contraseña común de las 12 cuentas @demo.zytech.dev (política de contraseñas). `--reiniciar`
# vacía TODA la base y exige ZYDESK_DEMO_CONFIRMAR con el nombre de la base (p. ej. zydesk). En una instalación
# definitiva las tres quedan vacías
ZYDESK_DEMO=
DEMO_PASSWORD=
ZYDESK_DEMO_CONFIRMAR=

# Web (solo desarrollo)
WEB_PUERTO=5173

# Telegram (spec fase 6 §9.1; manual de administración, sección 17). Lo usan la API y el bot. Sin token la API
# no ofrece la vinculación y los envíos quedan `omitido / sin_token`. NUNCA el token real en el repo ni en el chat
TELEGRAM_BOT_TOKEN=
# @usuario del bot sin `@`: arma el enlace https://t.me/<usuario>?start=<código> y el QR
TELEGRAM_BOT_USUARIO=
# Clave compartida entre la API y el bot: autentica `POST /api/bot/vincular` (X-Bot-Key) y firma (HMAC-SHA256) los
# códigos de vinculación guardados en la base. Obligatoria con TELEGRAM_BOT_TOKEN; en producción mínimo 32
# caracteres (p. ej. `openssl rand -base64 32`) y distinta de este valor de desarrollo. Rotarla exige reiniciar API
# y bot e invalida los códigos de vinculación vigentes (vencen a los 10 min de todos modos)
BOT_API_KEY=clave-de-desarrollo-cambiar-en-produccion
# Base de los enlaces enviados por Telegram y de los que arma el bot: http(s)://; en producción https:// (Telegram
# solo hace clicables los enlaces https; con localhost se ven como texto)
WEB_URL=http://localhost:5173

# Bot de Telegram (apps/bot; usa también TELEGRAM_BOT_TOKEN, BOT_API_KEY y WEB_URL de arriba). Sin
# TELEGRAM_BOT_TOKEN el proceso termina en silencio al arrancar `npm run dev`
# URL de la API: http://localhost:3010 en desarrollo; http://api:3000 en Docker (ADR 0013). Nunca el dominio público
API_URL=http://localhost:3010
# Directorio del archivo de sesiones cifrado `sesiones.json.enc` (relativo a la raíz del repo; `datos/` está en
# .gitignore). Perderlo solo obliga a volver a vincular; los avisos los envía la API y no dependen de él
BOT_DATOS_DIR=./datos/bot
# 32 bytes en base64 (AES-256-GCM del archivo de sesiones). Obligatoria con TELEGRAM_BOT_TOKEN.
# Generar con: openssl rand -base64 32. Cambiarla deja el archivo ilegible: el bot arranca vacío y todas las
# personas deben volver a vincular (siguen recibiendo avisos mientras tanto)
BOT_CLAVE_CIFRADO=
