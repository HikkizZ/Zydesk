# Zydesk · producción / demo (spec fase 9 §5.3). Copiar a /srv/apps/zydesk/.env (chmod 600). Nunca versionar el .env real.
# Solo valores de ejemplo o vacíos. Los comentarios van en su propia línea (no tras el valor): los scripts de
# docker/vps/ leen este archivo con grep y un comentario al final se pegaría al valor.
# Las contraseñas de Postgres van dentro de una URL sin codificar: no pueden contener @ / : ni #. Generarlas con:
#   openssl rand -base64 32 | tr '+/=' 'xyz'

# Etiqueta en ejecución (vX.Y.Z); la escribe desplegar.sh
ZYDESK_VERSION=
# Dueño del repo en GitHub, en minúsculas (imágenes ghcr.io/<dueño>/zydesk-{api,web,bot})
GHCR_OWNER=hikkizz
DATOS_DIR=/srv/data/zydesk

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=zydesk
ZYDESK_OWNER_PASSWORD=
ZYDESK_APP_PASSWORD=

# Saltos de proxy delante de la API: cloudflared, nginx-proxy y zydesk-web (ADR 0020)
PROXY_SALTOS=3
UF_ACTUALIZAR=true
# error | warn | info (en producción la API rechaza debug)
LOG_LEVEL=info
# Base de los enlaces de Telegram: en producción debe ser https://
WEB_URL=https://desk.zytech.dev

# Telegram (opcional; en la demo, un bot distinto del de desarrollo y del definitivo)
# `bot` levanta apps/bot; vacío no lo levanta
COMPOSE_PROFILES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USUARIO=
# openssl rand -base64 32 (mínimo 32 caracteres; la API no arranca con el valor de desarrollo)
BOT_API_KEY=
# openssl rand -base64 32 (exactamente 32 bytes)
BOT_CLAVE_CIFRADO=
# Chat que recibe los avisos de despliegue, respaldo y errores (con TELEGRAM_BOT_TOKEN)
TELEGRAM_CHAT_ADMIN=

# Solo la demo (spec §11): sin ZYDESK_DEMO=true el comando `demo` se niega a correr. DEMO_PASSWORD abre las 12 cuentas:
# openssl rand -base64 18
ZYDESK_DEMO=
DEMO_PASSWORD=
# Solo la instalación definitiva, y solo durante `admin`: luego se borra del .env
ADMIN_PASSWORD=

# Respaldos (los lee respaldar.sh, como root)
# Clave pública age (age1…); la privada vive en /root/.config/zydesk/age.txt y fuera del VPS
RESPALDO_AGE_DESTINATARIO=
# Destino rclone, p. ej. b2:zydesk-respaldos. Vacío = respaldos solo locales (la copia remota queda desactivada)
RCLONE_DESTINO=
RESPALDO_RETENCION_LOCAL_DIAS=14
RESPALDO_RETENCION_REMOTA_DIAS=90
